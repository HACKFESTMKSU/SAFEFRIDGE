# =============================================================================
# ColdGuard — environment placeholders
# Copy to the service that needs them (or set in Vercel / Render dashboards).
# Never commit real secrets.
# =============================================================================

# --- Frontend (Vercel → Project Settings → Environment Variables) ---
# Public URL of the Render API, including /api
VITE_API_URL=https://YOUR_RENDER_SERVICE.onrender.com/api

# --- Backend (Render Web Service → Environment) ---
# Supabase → Project Settings → Database → Connection string →
#   Type: URI, Mode: Transaction pooler (port 6543)
# Paste as-is (postgres://…); the app rewrites it to postgresql+psycopg://
# Example:
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional override if auto-detect misses the pooler (sets prepare_threshold=None)
# DATABASE_POOLER=true

# Required in production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=480

# Comma-separated allowed browser origins (your Vercel URL, no trailing slash)
CORS_ORIGINS=https://YOUR_VERCEL_APP.vercel.app

# MQTT — match the Arduino lab sketch (broker.emqx.io) for live ESP32 → dashboard
MQTT_ENABLED=true
MQTT_HOST=broker.emqx.io
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Produce vision agent (optional — static crop profiles work without it)
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5
VISION_MODEL=yolov8n.pt

# Email alerts via Resend (optional — incidents still appear in the dashboard)
# https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=ColdGuard <onboarding@resend.dev>
NOTIFY_EMAILS=operator@example.com,admin@example.com

# Rule engine
RULE_CONSECUTIVE_BREACHES=2
RULE_BREACH_WINDOW_SECONDS=600
DEVICE_OFFLINE_SECONDS=300
