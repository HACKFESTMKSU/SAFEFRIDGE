# Copy this file to `.env` and fill in values:
#   cp .env.example .env
# (On Windows PowerShell: `copy .env.example .env`)

# --- PostgreSQL ---
# Password for the `coldguard` Postgres user. Keep it simple for the demo.
POSTGRES_PASSWORD=coldguard

# --- JWT (backend) ---
# Secret used to sign login tokens. Change for anything real.
JWT_SECRET=coldguard-dev-secret-change-in-production-0123456789

# --- MQTT auth (optional — demo runs with allow_anonymous true) ---
# Only needed if you switch Mosquitto to password auth (see README).
# MQTT_USERNAME=coldguard
# MQTT_PASSWORD=coldguard
