# --- Database ---
# Default is SQLite so the backend runs with zero setup.
# For PostgreSQL (see infra/docker-compose) use:
# DATABASE_URL=postgresql+psycopg://coldguard:coldguard@localhost:5432/coldguard
DATABASE_URL=sqlite:///./coldguard.db

# --- Auth ---
JWT_SECRET=coldguard-dev-secret-change-in-production-0123456789
JWT_EXPIRE_MINUTES=480

# --- MQTT ingest ---
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Rule engine ---
# Consecutive breaches required before an incident is created (60s sampling -> 2 = ~1-2 min)
RULE_CONSECUTIVE_BREACHES=2
RULE_BREACH_WINDOW_SECONDS=600
# Seconds without telemetry before a linked device is flagged offline
DEVICE_OFFLINE_SECONDS=300

# --- Email notifications (optional; incidents are logged if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=coldguard@localhost
SMTP_USE_TLS=true
NOTIFY_EMAILS=operator@coldguard.local,admin@coldguard.local

# --- Produce vision agent (optional) ---
# Without ANTHROPIC_API_KEY, characterization still applies catalog profiles via static fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
VISION_MODEL=yoloe-26s-seg.pt
