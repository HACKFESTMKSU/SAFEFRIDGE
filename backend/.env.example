# --- Database ---
# Local default: SQLite (zero setup).
# Supabase (recommended for Render): Transaction pooler URI (port 6543)
#   Project Settings → Database → Connect → Connection string → URI + Transaction
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# DATABASE_POOLER=true
# Local Postgres (docker compose):
# DATABASE_URL=postgresql+psycopg://coldguard:coldguard@localhost:5432/coldguard
DATABASE_URL=sqlite:///./coldguard.db

# --- Auth ---
JWT_SECRET=coldguard-dev-secret-change-in-production-0123456789
JWT_EXPIRE_MINUTES=480

# --- CORS (production frontends; localhost Vite ports always allowed) ---
# CORS_ORIGINS=https://YOUR_VERCEL_APP.vercel.app

# --- MQTT ingest ---
# Local Mosquitto: localhost. Render + lab ESP32: broker.emqx.io (same as Arduino sketch).
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Rule engine ---
RULE_CONSECUTIVE_BREACHES=2
RULE_BREACH_WINDOW_SECONDS=600
DEVICE_OFFLINE_SECONDS=300

# --- Email notifications via Resend (optional; incidents are logged if unset) ---
# https://resend.com/api-keys — use onboarding@resend.dev until your domain is verified
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM=ColdGuard <onboarding@resend.dev>
NOTIFY_EMAILS=operator@coldguard.local,admin@coldguard.local

# --- Produce vision agent (optional) ---
# Without ANTHROPIC_API_KEY, characterization still applies catalog profiles via static fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# Default: YOLOv8n (~6MB, COCO fruits/veg). YOLOE/World need 200MB+ CLIP downloads.
VISION_MODEL=yolov8n.pt
